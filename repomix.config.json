{
    "$schema": "https://repomix.com/repomix-config.schema.json",
    "output": {
        "filePath": "repomix-output.xml",
        "style": "xml",
        "parsable": true
    },
    "include": [
        "src/**/*",
        "include/**/*",
        "libs/CMakeLists.txt",
        "CMakeLists.txt",
        "README.md"
    ],
    "ignore": {
        "useGitignore": true,
        "customPatterns": [
            "**/build/**",
            "**/.vscode/**",
            "**/libs/SFML-*/**",
            "**/*.dll",
            "**/*.exe",
            "**/*.a",
            "**/*.lib",
            "**/*.o",
            "**/*.obj",
            "**/.git/**"
        ]
    }
}